PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-something-random

# Postgres — required. postgres://user:password@host:port/database
DATABASE_URL=

# X / Twitter — https://developer.twitter.com/en/portal
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Set true only after LinkedIn approves organization/page posting scopes.
LINKEDIN_ENABLE_ORGANIZATIONS=false

# Facebook + Instagram — https://developers.facebook.com/apps
FB_APP_ID=
FB_APP_SECRET=

# TikTok — https://developers.tiktok.com/ (enable Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google / YouTube — https://console.cloud.google.com/ (enable YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenRouter — https://openrouter.ai/keys (used when a user hasn't set their
# own key in AI Settings). OPENROUTER_BASE_URL is optional.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# OpenAI — https://platform.openai.com/api-keys (optional server fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Google Gemini — https://aistudio.google.com/app/apikey (optional server fallback)
GEMINI_API_KEY=
GEMINI_BASE_URL=

# AI video generation — how long (ms) a text-to-video request may take before
# it's abandoned. Veo-class models often take a few minutes, and some relays
# hold the connection open for the whole generation. Defaults to 720000 (12 min).
VIDEO_API_TIMEOUT_MS=720000
